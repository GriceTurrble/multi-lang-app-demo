# Localized `just` command for this file only
just_local := "just --justfile " + source_file()
just_manage := "just --justfile ../mlad-manage/Justfile"

# Show these help docs
[default]
@help:
    echo "{{GREEN}}[MLAD] Integration tests{{NORMAL}}"
    echo "{{GREEN}}>> $(pwd){{NORMAL}}"
    echo ""
    just --list --unsorted --justfile {{ source_file() }}

# Install all test environment prerequisites (idempotent)
bootstrap:
    {{just_local}} sync
    npx playwright install chromium

# Install npm dependencies
sync:
    npm install

TEST_DB := "postgresql://postgres:postgres@localhost:5432/mlad"

# Run integration tests
test:
    #!/usr/bin/env bash
    set -euo pipefail
    trap 'docker compose -f ../compose.test.yaml down --remove-orphans' EXIT
    docker compose -f ../compose.test.yaml up -d --build --wait || {
        echo ""
        echo "--- Stack startup failed. Service logs:"
        docker compose -f ../compose.test.yaml logs --no-color
        exit 1
    }
    DATABASE_URL={{TEST_DB}} \
        {{just_manage}} run db migrate run
    npx playwright test
